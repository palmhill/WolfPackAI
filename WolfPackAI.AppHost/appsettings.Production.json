{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting": "Information"
    }
  },
  "LiteLLM": {
    "GeneralSettings": {
      "MasterKey": "${LITELLM_MASTER_KEY}"
    }
  },
  "Postgres": {
    "Username": "${POSTGRES_USERNAME}",
    "Password": "${POSTGRES_PASSWORD}",
    "Port": 5432
  },
  "OpenWebUI": {
    "PublicUrl": "${OPENWEBUI_PUBLIC_URL}",
    "EnableOAuth": false
  },
  "Dashboard": {
    "HttpPort": 80,
    "HttpsPort": 443
  }
}
