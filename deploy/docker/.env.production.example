# WolfPackAI Production Environment Variables
# Copy this to .env.production and fill in your secure values

# PostgreSQL Configuration
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# LiteLLM Configuration
LITELLM_MASTER_KEY=CHANGE_ME_SECURE_KEY
LITELLM_PORT=4000
LITELLM_UI_USERNAME=admin

# OpenWebUI Configuration
OPENWEBUI_PUBLIC_URL=https://yourdomain.com/chat
OPENWEBUI_PORT=8080
CORS_ALLOW_ORIGIN=https://yourdomain.com

# n8n Configuration
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_SECURE_PASSWORD
N8N_WEBHOOK_URL=https://yourdomain.com/n8n/
TIMEZONE=America/New_York

# Ollama Configuration
OLLAMA_HOST_PORT=1143

# Dashboard Configuration
DASHBOARD_HTTP_PORT=80
DASHBOARD_HTTPS_PORT=443
