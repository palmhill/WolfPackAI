# WolfPackAI Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# LiteLLM Configuration
LITELLM_MASTER_KEY=sk-your-secure-key-here

# PostgreSQL Configuration
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_PORT=5432

# OpenWebUI Configuration
OPENWEBUI_PUBLIC_URL=http://localhost/chat

# n8n Configuration
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your-secure-password-here

# Optional: Azure AD OAuth (if using production auth)
# AZURE_AD_TENANT_ID=your-tenant-id
# AZURE_AD_CLIENT_ID=your-client-id
# AZURE_AD_CLIENT_SECRET=your-client-secret

# Optional: Ollama Configuration
OLLAMA_HOST_PORT=1143
OLLAMA_MODEL=deepseek-coder-v2:16b

# Optional: SSL Configuration
LITELLM_SSL_ENABLED=false
LITELLM_SSL_DOMAIN=litellm.example.com
LITELLM_SSL_EMAIL=your-email@example.com
