{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "openwebui-route": {
        "ClusterId": "openwebui-cluster",
        "Match": {
          "Path": "/chat/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/chat" }
        ]
      },
      "litellm-route": {
        "ClusterId": "litellm-cluster",
        "Match": {
          "Path": "/litellm/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/litellm" }
        ]
      },
      "n8n-route": {
        "ClusterId": "n8n-cluster",
        "Match": {
          "Path": "/n8n/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/n8n" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/n8n" }
        ]
      }
    },
    "Clusters": {
      "openwebui-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://openwebui:8080"
          }
        }
      },
      "litellm-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://litellm:4000"
          }
        }
      },
      "n8n-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://n8n:5678"
          }
        }
      }
    }
  }
}